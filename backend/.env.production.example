# Render persistent-disk deployment. Do not enable public Supabase storage.
DATABASE_URL=sqlite:////var/data/rankafrica.db
UPLOAD_DIR=/var/data/uploads
SECRET_KEY=SET_A_RANDOM_SECRET_IN_THE_HOSTING_DASHBOARD
DEMO_PASSWORD=SET_A_PRIVATE_DEMO_PASSWORD_BEFORE_FIRST_START
AUTO_SEED=true
INIT_DB_ON_STARTUP=true
AI_ENABLED=false
APP_ENV=assessment
APP_DEBUG=false
