# Local fictional demonstration only. Never commit .env.
DATABASE_URL=sqlite:///./rankafrica.db
SECRET_KEY=replace-with-a-long-random-value
AUTO_SEED=true
INIT_DB_ON_STARTUP=true
AI_ENABLED=false
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set before first startup to change ALL seeded demonstration passwords.
DEMO_PASSWORD=DemoPrivacy2026!

APP_ENV=development
APP_DEBUG=true
SEED_DEMO_STUDENTS=false
ENABLE_STUDENT_CLEANUP=false
STUDY_CONTACT=
STUDY_RETENTION_NOTICE=

# Optional identified exit-review delivery; configure actual SMTP settings above.
EXIT_FEEDBACK_RECIPIENT=
SMTP_USE_SSL=false
